// PeppolFlow persistence foundation
// Business rules, authentication, and tenant provisioning intentionally stay
// outside this first dashboard build.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  plan        String       @default("professional")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  clients     Client[]

  @@map("organizations")
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]

  @@map("users")
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String?
  accountingPackage String?
  peppolStatus   PeppolStatus @default(NOT_REGISTERED)
  readinessScore Int          @default(0)
  lastCheckedAt  DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, peppolStatus])
  @@map("clients")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum PeppolStatus {
  READY
  CONFIGURING
  AT_RISK
  NOT_REGISTERED
}