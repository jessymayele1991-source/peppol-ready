generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  plan        OrganizationPlan @default(PROFESSIONAL)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  memberships Membership[]
  companies   Company[]
  tasks       Task[]
  incidents   Incident[]
  auditEvents AuditEvent[]
  reports     Report[]

  @@map("organizations")
}

model User {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  avatarInitials   String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  memberships      Membership[]
  assignedTasks    Task[]          @relation("TaskAssignee")
  createdTasks     Task[]          @relation("TaskCreator")
  auditEvents      AuditEvent[]    @relation("AuditActor")
  completedScans   ReadinessScan[] @relation("ReadinessScanCompleter")
  generatedReports Report[]        @relation("ReportGenerator")
  preferredLocale  String          @default("nl")

  @@map("users")
}

model Membership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model Company {
  id                 String           @id @default(cuid())
  organizationId     String
  name               String
  legalName          String?
  email              String?
  registrationNumber String?
  vatNumber          String?
  industry           String?
  accountingPackage  String?
  peppolStatus       PeppolStatus     @default(NOT_REGISTERED)
  readinessScore     Int              @default(0)
  lastCheckedAt      DateTime?        @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  readinessScores    ReadinessScore[]
  tasks              Task[]
  incidents          Incident[]
  contacts           ClientContact[]
  readinessScans     ReadinessScan[]
  reports            Report[]

  @@index([organizationId, peppolStatus])
  @@index([organizationId, name])
  @@map("companies")
}

model ClientContact {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  role      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isPrimary])
  @@map("client_contacts")
}

model ReadinessScan {
  id            String            @id @default(cuid())
  companyId     String
  completedById String?
  score         Int
  category      ReadinessCategory
  source        String?
  startedAt     DateTime          @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?         @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  completedBy   User?             @relation("ReadinessScanCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  checks        ReadinessCheck[]

  @@index([companyId, completedAt])
  @@map("readiness_scans")
}

model ReadinessCheck {
  id        String        @id @default(cuid())
  scanId    String
  key       String
  passed    Boolean
  evidence  String?
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  scan      ReadinessScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, key])
  @@map("readiness_checks")
}

model ReadinessScore {
  id        String       @id @default(cuid())
  companyId String
  score     Int
  status    PeppolStatus
  checkedAt DateTime     @db.Timestamptz(3)
  source    String?
  details   Json?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, checkedAt])
  @@map("readiness_scores")
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  companyId      String?
  assignedToId   String?
  createdById    String?
  title          String
  description    String?
  status         TaskStatus   @default(OPEN)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?    @db.Timestamptz(3)
  completedAt    DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo     User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, priority])
  @@index([companyId])
  @@map("tasks")
}

model Incident {
  id             String           @id @default(cuid())
  organizationId String
  companyId      String?
  title          String
  description    String?
  severity       IncidentSeverity @default(WARNING)
  status         IncidentStatus   @default(OPEN)
  occurredAt     DateTime         @db.Timestamptz(3)
  resolvedAt     DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, severity])
  @@index([companyId, occurredAt])
  @@map("incidents")
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  eventType      String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}

model Report {
  id             String       @id @default(cuid())
  organizationId String
  companyId      String?
  generatedById  String?
  type           ReportType
  status         ReportStatus @default(PENDING)
  locale         String       @default("nl")
  filePath       String?
  periodStart    DateTime?    @db.Timestamptz(3)
  periodEnd      DateTime?    @db.Timestamptz(3)
  generatedAt    DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  generatedBy    User?        @relation("ReportGenerator", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([organizationId, type, createdAt])
  @@index([companyId])
  @@map("reports")
}

enum OrganizationPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum PeppolStatus {
  READY
  CONFIGURING
  AT_RISK
  NOT_REGISTERED
}

enum ReadinessCategory {
  NOT_STARTED
  BASIC
  ADVANCED
  READY
  FULLY_COMPLIANT
}

enum ReportType {
  READINESS
  RISK
  MANAGEMENT
}

enum ReportStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum IncidentSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}
