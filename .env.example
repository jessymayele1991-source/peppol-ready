# Local development settings for `pnpm dev`.
# Copy to `.env` in the repository root:  cp .env.example .env
#
# `docker compose up` does not read this file; it sets its own values in
# docker-compose.yml. Variables already present in your shell always win over
# this file. On Replit these come from Secrets instead and no .env exists.

# PostgreSQL — matches the `db` service from `pnpm db:up` / docker-compose.yml.
DATABASE_URL=postgresql://peppol:peppol@localhost:5432/peppol_ready

# Port the API listens on. The web dev server proxies /api to it.
PORT=8080

# Password for the seeded demo accounts. Optional for a database on localhost,
# where it falls back to the public development password; required (12+
# characters) for any other host. The seed refuses to run in production.
# SEED_PASSWORD=choose-a-local-password

# Not needed locally: development falls back to a built-in secret. Production
# requires 32+ random characters — generate with `openssl rand -base64 48`.
# SESSION_SECRET=

# Optional: log verbosity (trace, debug, info, warn, error).
# LOG_LEVEL=info

# Only needed when the tenant integrity tests should run against a database.
# TEST_DATABASE_URL=postgresql://peppol:peppol@localhost:5432/peppol_ready
